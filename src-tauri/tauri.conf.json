{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "companion",
  "version": "0.1.0",
  "identifier": "com.opensource.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mascot",
        "title": "Companion Mascot",
        "url": "index.html?window=mascot",
        "width": 380,
        "height": 520,
        "minWidth": 260,
        "minHeight": 360,
        "maxWidth": 800,
        "maxHeight": 1000,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "dashboard",
        "title": "Companion Dashboard",
        "url": "index.html?window=dashboard",
        "width": 1000,
        "height": 720,
        "minWidth": 650,
        "minHeight": 450,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Screen Annotation Overlay",
        "url": "index.html?window=overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
